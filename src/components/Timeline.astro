---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { education, work, type TimelineEntry } from "../data/profile";

const organizationLogoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.{svg,png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const organizationLogos = Object.fromEntries(
  Object.entries(organizationLogoModules).map(([path, module]) => [
    path.split("/").at(-1)?.replace(/\.[^.]+$/, ""),
    module.default,
  ]),
) as Record<string, ImageMetadata>;

const getOrganizationLogo = (key?: string) => (key ? organizationLogos[key] : undefined);

const getOrganizationLogoAlt = (entry: TimelineEntry) =>
  entry.logoAlt ?? (entry.organization ? `Logo von ${entry.organization}` : `Logo zu ${entry.title}`);

const getOrganizationMonogram = (entry: TimelineEntry) => {
  if (entry.logoMonogram) return entry.logoMonogram;

  const initials = entry.organization
    ?.split(/\s+/)
    .filter((word) => /[\p{L}\p{N}]/u.test(word))
    .slice(0, 3)
    .map((word) => word.match(/[\p{L}\p{N}]/u)?.[0] ?? "")
    .join("")
    .toUpperCase();

  return initials || entry.title.slice(0, 2).toUpperCase();
};
---

<section class="journey section-shell" id="laufbahn" aria-labelledby="journey-title">
  <header class="section-heading" data-reveal="up">
    <h2 id="journey-title">Beruf und Studium.</h2>
  </header>

  <div class="journey-layout">
    <aside class="journey-companion" data-journey-companion data-mode="work">
      <div class="companion-art" aria-hidden="true">
        <div class="companion-wave-layer companion-wave-layer-primary">
          <div class="companion-wave-motion">
            {Array.from({ length: 7 }, (_, index) => <span style={`--wave-index: ${index}`}></span>)}
          </div>
        </div>
        <div class="companion-wave-layer companion-wave-layer-echo">
          <div class="companion-wave-motion">
            {Array.from({ length: 5 }, (_, index) => <span style={`--wave-index: ${index}`}></span>)}
          </div>
        </div>
      </div>
      <div class="companion-meta">
        <p class="companion-kind" data-companion-kind>Beruf</p>
        <p class="companion-period" data-companion-period>{work[0].period}</p>
      </div>
      <h3 data-companion-title>
        <span data-companion-title-main>{work[0].companionTitle}</span>{" "}<span class="companion-title-detail" data-companion-title-detail hidden={!work[0].companionDetail}>{work[0].companionDetail}</span>
      </h3>
    </aside>

    <div class="journey-stories">
      <section class="journey-group" id="beruf" aria-labelledby="work-title">
        <header class="journey-group-heading">
          <span class="group-icon"><i class="ph ph-briefcase" aria-hidden="true"></i></span>
          <div>
            <h3 id="work-title">Marketing und E-Commerce</h3>
          </div>
        </header>

        <div class="journey-cards" data-timeline-group>
          {work.map((entry) => {
            const organizationLogo = getOrganizationLogo(entry.logoKey);

            return (
              <article
              class:list={["journey-card", entry.current && "is-current", entry.backDetails && "has-flip"]}
              data-flip-card={entry.backDetails ? "true" : undefined}
              data-story-card
              data-story-kind="Beruf"
              data-story-period={entry.period}
              data-story-title={entry.title}
              data-story-companion-title={entry.companionTitle}
              data-story-companion-detail={entry.companionDetail}
              data-timeline-point
              data-reveal="up"
            >
              <div class="journey-card-inner">
                <div class="journey-card-face journey-card-front" data-flip-front>
                  <div class="journey-card-top">
                    <span class="journey-date">{entry.period}</span>
                    {entry.logoKey ? (
                      <span
                        class:list={["journey-card-icon", "journey-organization-logo", !organizationLogo && "is-fallback"]}
                        data-logo-key={entry.logoKey}
                        role={organizationLogo ? undefined : "img"}
                        aria-label={organizationLogo ? undefined : getOrganizationLogoAlt(entry)}
                      >
                        {organizationLogo ? (
                          <Image
                            src={organizationLogo}
                            alt={getOrganizationLogoAlt(entry)}
                            width={180}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <strong aria-hidden="true">{getOrganizationMonogram(entry)}</strong>
                        )}
                      </span>
                    ) : (
                      <span class="journey-card-icon" aria-hidden="true"><i class:list={["ph", entry.icon]}></i></span>
                    )}
                  </div>
                  {entry.context && (
                    <p class="journey-context"><i class="ph ph-link-simple-horizontal" aria-hidden="true"></i>{entry.context}</p>
                  )}
                  <h4>{entry.roleProgression ? entry.organization : entry.title}</h4>
                  {entry.organization && !entry.roleProgression && <p class="journey-organization">{entry.organization}</p>}
                  {entry.roleProgression && (
                    <ol class="journey-role-progression" aria-label="Rollen bei DERTOUR Austria, neueste zuerst">
                      {entry.roleProgression.map((role) => (
                        <li class:list={["journey-role-step", role.current && "is-latest"]}>
                          {role.current && (
                            <button
                              class="journey-level-up"
                              type="button"
                              data-level-up
                              aria-label="Level-up-Klang abspielen"
                            >
                              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                            </button>
                          )}
                          <span class="journey-role-copy">
                            <span class="journey-role-period">{role.period}</span>
                            <strong data-level-up-target={role.current ? "true" : undefined}>{role.title}</strong>
                          </span>
                        </li>
                      ))}
                    </ol>
                  )}
                  <p class="journey-description">{entry.description}</p>
                  {entry.details && (
                    <ul class="journey-details">
                      {entry.details.map((detail) => (
                        <li><i class="ph ph-arrow-bend-down-right" aria-hidden="true"></i>{detail}</li>
                      ))}
                    </ul>
                  )}
                  {entry.backDetails && (
                    <button class="journey-flip-button site-action" type="button" data-flip-open aria-expanded="false" aria-label={`Details zu ${entry.title} anzeigen`}>
                      Genauer ansehen <i class="ph ph-arrow-clockwise" aria-hidden="true"></i>
                    </button>
                  )}
                </div>

                {entry.backDetails && (
                  <div class="journey-card-face journey-card-back" data-flip-back aria-hidden="true" inert>
                    <div class="journey-back-top">
                      <span class="journey-copy-line" style="--copy-index: 0"><i class="ph ph-list-magnifying-glass" aria-hidden="true"></i>Ein Blick dahinter</span>
                    </div>
                    <h4><span class="journey-copy-line" style="--copy-index: 1">{entry.backTitle}</span></h4>
                    <p class="journey-back-intro"><span class="journey-copy-line" style="--copy-index: 2">{entry.backIntro}</span></p>
                    <div class="journey-back-grid">
                      {entry.backDetails.map((detail, index) => (
                        <article style={`--detail-index: ${index}`}>
                          <i class:list={["ph", detail.icon]} aria-hidden="true"></i>
                          <h5><span class="journey-copy-line" style={`--copy-index: ${3 + index * 2}`}>{detail.title}</span></h5>
                          <p><span class="journey-copy-line" style={`--copy-index: ${4 + index * 2}`}>{detail.text}</span></p>
                        </article>
                      ))}
                    </div>
                    <button class="journey-flip-button journey-flip-back-button site-action site-action-secondary" type="button" data-flip-close aria-label={`Vorderseite von ${entry.title} anzeigen`}>
                      Zur Vorderseite <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>
                    </button>
                  </div>
                )}
              </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="journey-group" id="ausbildung" aria-labelledby="education-title">
        <header class="journey-group-heading">
          <span class="group-icon"><i class="ph ph-graduation-cap" aria-hidden="true"></i></span>
          <div>
            <h3 id="education-title">Studium, Schule und Abschlussarbeit</h3>
          </div>
        </header>

        <div class="journey-cards journey-cards-education" data-timeline-group>
          {education.map((entry) => {
            const organizationLogo = getOrganizationLogo(entry.logoKey);

            return (
              <article
              class:list={["journey-card", "journey-card-education", entry.backDetails && "has-flip"]}
              data-flip-card={entry.backDetails ? "true" : undefined}
              data-story-card
              data-story-kind="Studium"
              data-story-period={entry.period}
              data-story-title={entry.title}
              data-story-companion-title={entry.companionTitle}
              data-story-companion-detail={entry.companionDetail}
              data-timeline-point
              data-reveal="up"
            >
              <div class="journey-card-inner">
                <div class="journey-card-face journey-card-front" data-flip-front>
                  <div class="journey-card-top">
                    <span class="journey-date">{entry.period}</span>
                    {entry.logoKey ? (
                      <span
                        class:list={["journey-card-icon", "journey-organization-logo", !organizationLogo && "is-fallback"]}
                        data-logo-key={entry.logoKey}
                        role={organizationLogo ? undefined : "img"}
                        aria-label={organizationLogo ? undefined : getOrganizationLogoAlt(entry)}
                      >
                        {organizationLogo ? (
                          <Image
                            src={organizationLogo}
                            alt={getOrganizationLogoAlt(entry)}
                            width={180}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <strong aria-hidden="true">{getOrganizationMonogram(entry)}</strong>
                        )}
                      </span>
                    ) : (
                      <span class="journey-card-icon" aria-hidden="true"><i class:list={["ph", entry.icon]}></i></span>
                    )}
                  </div>
                  {entry.context && (
                    <p class="journey-context"><i class="ph ph-link-simple-horizontal" aria-hidden="true"></i>{entry.context}</p>
                  )}
                  <h4>{entry.title}</h4>
                  {entry.organization && <p class="journey-organization">{entry.organization}</p>}
                  <p class="journey-description">{entry.description}</p>
                  {entry.backDetails && (
                    <button class="journey-flip-button site-action" type="button" data-flip-open aria-expanded="false" aria-label={`Details zu ${entry.title} anzeigen`}>
                      Genauer ansehen <i class="ph ph-arrow-clockwise" aria-hidden="true"></i>
                    </button>
                  )}
                </div>

                {entry.backDetails && (
                  <div class="journey-card-face journey-card-back" data-flip-back aria-hidden="true" inert>
                    <div class="journey-back-top">
                      <span class="journey-copy-line" style="--copy-index: 0"><i class="ph ph-list-magnifying-glass" aria-hidden="true"></i>Ein Blick dahinter</span>
                    </div>
                    <h4><span class="journey-copy-line" style="--copy-index: 1">{entry.backTitle}</span></h4>
                    <p class="journey-back-intro"><span class="journey-copy-line" style="--copy-index: 2">{entry.backIntro}</span></p>
                    <div class="journey-back-grid">
                      {entry.backDetails.map((detail, index) => (
                        <article style={`--detail-index: ${index}`}>
                          <i class:list={["ph", detail.icon]} aria-hidden="true"></i>
                          <h5><span class="journey-copy-line" style={`--copy-index: ${3 + index * 2}`}>{detail.title}</span></h5>
                          <p><span class="journey-copy-line" style={`--copy-index: ${4 + index * 2}`}>{detail.text}</span></p>
                        </article>
                      ))}
                    </div>
                    <button class="journey-flip-button journey-flip-back-button site-action site-action-secondary" type="button" data-flip-close aria-label={`Vorderseite von ${entry.title} anzeigen`}>
                      Zur Vorderseite <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>
                    </button>
                  </div>
                )}
              </div>
              </article>
            );
          })}
        </div>
      </section>
    </div>
  </div>
</section>

<style is:global>
  .journey .journey-companion h3 {
    overflow-wrap: break-word;
  }

  .journey .journey-companion .companion-title-detail:not([hidden]) {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.68em;
    line-height: 1.2;
  }

  /* The uploaded logos use different canvas sizes. These presentation tokens keep
     the marks visually balanced without modifying the source files. */
  .journey .journey-card-icon.journey-organization-logo {
    --organization-logo-scale: 0.94;
    --organization-logo-shift-x: 0;
    --organization-logo-shift-y: 0;
    position: relative;
    overflow: visible;
    width: clamp(7.5rem, 9.6vw, 9.25rem);
    height: 4.25rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    flex: none;
  }

  .journey .journey-organization-logo img {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    filter: none;
    mix-blend-mode: multiply;
    opacity: 1;
    transform: translate(var(--organization-logo-shift-x), var(--organization-logo-shift-y)) scale(var(--organization-logo-scale));
  }

  .journey .journey-organization-logo[data-logo-key="dertour-austria"] {
    --organization-logo-scale: 0.96;
  }

  .journey .journey-organization-logo[data-logo-key="landkreis-passau-gesundheit"] {
    --organization-logo-scale: 0.88;
  }

  .journey .journey-organization-logo[data-logo-key="universitaet-passau"] {
    --organization-logo-scale: 0.98;
  }

  .journey .journey-organization-logo[data-logo-key="asg-passau"] {
    --organization-logo-scale: 0.88;
  }

  .journey .journey-organization-logo.is-fallback {
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface-2) 78%, transparent);
  }

  .journey-role-progression {
    display: grid;
    gap: 0;
    margin: 1.65rem 0 0;
    padding: 0.55rem 0;
    border-block: 1px solid var(--line);
    list-style: none;
  }

  .journey-role-step {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 0;
  }

  .journey-role-step + .journey-role-step {
    border-top: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
  }

  .journey-role-step:not(.is-latest)::before {
    width: 0.43rem;
    height: 0.43rem;
    margin-inline: auto;
    border-radius: 50%;
    background: var(--line-strong);
    content: "";
  }

  .journey-role-copy {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .journey-role-period {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 570;
    line-height: 1.35;
  }

  .journey-role-copy strong {
    display: inline-block;
    color: var(--ink);
    font-size: clamp(0.83rem, 1.35vw, 0.96rem);
    font-weight: 590;
    line-height: 1.35;
  }

  .journey-role-step.is-latest .journey-role-copy strong {
    color: var(--accent-strong);
    font-size: clamp(1rem, 1.8vw, 1.22rem);
    font-weight: 760;
    letter-spacing: -0.025em;
    transform-origin: left center;
  }

  .journey-level-up {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    cursor: pointer;
    font-size: 0.95rem;
    transition: transform 220ms var(--ease-out), background-color 220ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .journey-level-up:hover {
      background: var(--accent-strong);
      transform: scale(1.13);
    }
  }

  @media (max-width: 48rem) {
    .journey-role-progression {
      margin-top: 1.35rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .journey .journey-card:hover .journey-organization-logo img {
      transform: translate(var(--organization-logo-shift-x), var(--organization-logo-shift-y)) scale(var(--organization-logo-scale));
    }
  }

  @media (max-width: 48rem) {
    .journey .journey-card-icon.journey-organization-logo {
      width: 5.7rem;
      height: 3.25rem;
    }

    .journey .journey-organization-logo[data-logo-key="dertour-austria"] {
      --organization-logo-scale: 0.96;
    }

    .journey .journey-organization-logo[data-logo-key="landkreis-passau-gesundheit"] {
      --organization-logo-scale: 0.88;
    }

    .journey .journey-organization-logo[data-logo-key="universitaet-passau"] {
      --organization-logo-scale: 0.97;
    }

    .journey .journey-organization-logo[data-logo-key="asg-passau"] {
      --organization-logo-scale: 0.87;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey .journey-organization-logo img,
    .journey-level-up {
      transition: none;
    }
  }
</style>

<script>
  import { initializeFlipCard } from "../scripts/flip-card";
  const levelUpButton = document.querySelector<HTMLButtonElement>("[data-level-up]");
  const levelUpTarget = document.querySelector<HTMLElement>("[data-level-up-target]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let levelUpAudio: AudioContext | undefined;

  levelUpButton?.addEventListener("click", async (event) => {
    event.stopPropagation();

    if (!reducedMotion.matches && levelUpTarget) {
      levelUpTarget.getAnimations().forEach((animation) => animation.cancel());
      levelUpTarget.animate(
        [
          { transform: "scale(1)" },
          { transform: "scale(1.12)", offset: 0.48 },
          { transform: "scale(1)" },
        ],
        { duration: 660, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
    }

    try {
      levelUpAudio ??= new AudioContext();
      await levelUpAudio.resume();
      const start = levelUpAudio.currentTime;
      // NES PowerUpGrabFreqData, played in reverse order at one pitch per two 60 Hz frames.
      // https://6502disassembly.com/nes-smb/SuperMarioBros.html
      const notes = [
        523, 391, 523, 658, 782, 1045, 782,
        414, 523, 621, 829, 621, 829, 1045, 1243, 1645, 1243,
        466, 586, 695, 932, 695, 932, 1165, 1381, 1864, 1381,
      ];
      const real = new Float32Array(33);
      const imaginary = new Float32Array(33);
      for (let harmonic = 1; harmonic < real.length; harmonic += 1) {
        const phase = 2 * Math.PI * harmonic * 0.25;
        real[harmonic] = (2 * Math.sin(phase)) / (Math.PI * harmonic);
        imaginary[harmonic] = (2 * (1 - Math.cos(phase))) / (Math.PI * harmonic);
      }
      const pulseWave = levelUpAudio.createPeriodicWave(real, imaginary);
      const noteLength = 2 / 60;
      notes.forEach((frequency, index) => {
        if (!levelUpAudio) return;
        const oscillator = levelUpAudio.createOscillator();
        const gain = levelUpAudio.createGain();
        const noteStart = start + index * noteLength;
        oscillator.setPeriodicWave(pulseWave);
        oscillator.frequency.setValueAtTime(frequency, noteStart);
        gain.gain.setValueAtTime(0, noteStart);
        gain.gain.linearRampToValueAtTime(0.04, noteStart + 0.0015);
        gain.gain.setValueAtTime(0.04, noteStart + noteLength - 0.003);
        gain.gain.linearRampToValueAtTime(0, noteStart + noteLength);
        oscillator.connect(gain);
        gain.connect(levelUpAudio.destination);
        oscillator.start(noteStart);
        oscillator.stop(noteStart + noteLength);
      });
    } catch {
      // The visual response still works when Web Audio is unavailable.
    }
  });

  document.querySelectorAll<HTMLElement>(".journey-card.has-flip").forEach((card) => {
    const openButton = card.querySelector<HTMLButtonElement>("[data-flip-open]");
    const closeButton = card.querySelector<HTMLButtonElement>("[data-flip-close]");
    const inner = card.querySelector<HTMLElement>(".journey-card-inner");
    const front = card.querySelector<HTMLElement>("[data-flip-front]");
    const back = card.querySelector<HTMLElement>("[data-flip-back]");
    initializeFlipCard({ card, inner, front, back, openButton, closeButton });
  });

  document.querySelectorAll<HTMLElement>("[data-timeline-group]").forEach((group) => {
    const points = Array.from(group.querySelectorAll<HTMLElement>("[data-timeline-point]"));
    if (!points.length) return;

    const activatePoint = (activeIndex: number) => {
      const progress = points.length === 1 ? 1 : activeIndex / (points.length - 1);
      group.style.setProperty("--timeline-progress", String(Math.max(0, Math.min(1, progress))));
      points.forEach((point, index) => {
        point.classList.toggle("is-reached", index <= activeIndex);
        point.classList.toggle("is-timeline-current", index === activeIndex);
      });
    };

    if (!("IntersectionObserver" in window)) {
      activatePoint(points.length - 1);
      return;
    }

    const pointObserver = new IntersectionObserver(
      (entries) => {
        const entering = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
        const target = entering.at(-1)?.target as HTMLElement | undefined;
        if (!target) return;
        const index = points.indexOf(target);
        if (index >= 0) activatePoint(index);
      },
      { rootMargin: "-42% 0px -48%", threshold: 0 },
    );

    points.forEach((point) => pointObserver.observe(point));
  });

</script>
