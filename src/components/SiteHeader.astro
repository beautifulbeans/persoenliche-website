---
import StatusIsland from "./StatusIsland.astro";
---

<header class="site-header" data-site-header>
  <StatusIsland />

  <nav aria-label="Hauptnavigation">
    <a href="#beruf">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Berufserfahrung</span><span class="nav-short">Beruf</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Berufserfahrung</span><span class="nav-short">Beruf</span></span>
      </span>
    </a>
    <a href="#ausbildung">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Studium + Bachelorarbeit</span><span class="nav-short">Studium</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Studium + Bachelorarbeit</span><span class="nav-short">Studium</span></span>
      </span>
    </a>
    <a href="#persoenlich">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Persönlich</span><span class="nav-short">Privat</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Persönlich</span><span class="nav-short">Privat</span></span>
      </span>
    </a>
    <a class="nav-contact" href="#kontakt">
      <span class="nav-label">
        <span class="nav-label-primary">Kontakt</span>
        <span class="nav-label-clone" aria-hidden="true">Kontakt</span>
      </span>
    </a>
  </nav>
</header>

<a class="mobile-contact-shortcut" href="#kontakt" data-mobile-contact aria-label="Direkt zu den Kontaktmöglichkeiten">
  <i class="ph ph-envelope-simple" aria-hidden="true"></i>
  <span>Kontakt</span>
</a>

<script>
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  const mobileContact = document.querySelector<HTMLAnchorElement>("[data-mobile-contact]");
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-site-header] nav a[href^='#']"));
  const observedSections = sectionLinks
    .map((link) => {
      const id = link.hash.slice(1);
      const section = document.getElementById(id);
      return section ? { link, section } : null;
    })
    .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(entry));

  const setCurrentSection = (activeLink: HTMLAnchorElement) => {
    sectionLinks.forEach((link) => {
      if (link === activeLink) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
    siteHeader?.setAttribute("data-section-mode", activeLink.hash === "#persoenlich" || activeLink.hash === "#kontakt" ? "personal" : "professional");
  };

  if ("IntersectionObserver" in window) {
    const navigationObserver = new IntersectionObserver(
      (entries) => {
        const active = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!active) return;
        const match = observedSections.find(({ section }) => section === active.target);
        if (match) setCurrentSection(match.link);
      },
      { rootMargin: "-18% 0px -62%", threshold: [0, 0.12, 0.4] },
    );
    observedSections.forEach(({ section }) => navigationObserver.observe(section));
  }

  sectionLinks.forEach((link) => link.addEventListener("click", () => setCurrentSection(link)));

  const contactSection = document.getElementById("kontakt");
  let contactScrollFrame = 0;
  const syncMobileContact = () => {
    contactScrollFrame = 0;
    mobileContact?.classList.toggle("is-compact", window.scrollY > 96);
  };

  window.addEventListener("scroll", () => {
    if (contactScrollFrame) return;
    contactScrollFrame = window.requestAnimationFrame(syncMobileContact);
  }, { passive: true });
  syncMobileContact();

  if (mobileContact && contactSection && "IntersectionObserver" in window) {
    const contactObserver = new IntersectionObserver(
      ([entry]) => mobileContact.classList.toggle("is-hidden", Boolean(entry?.isIntersecting)),
      { threshold: 0.08 },
    );
    contactObserver.observe(contactSection);
  }
</script>
