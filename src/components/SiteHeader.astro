---
import { Image } from "astro:assets";
import portrait from "../assets/portrait/fabian-deragisch.jpg";
---

<header class="site-header" data-site-header>
  <div class="header-identity">
    <a class="wordmark" href="#oben" aria-label="Zurück zum Anfang">
      <span class="wordmark-avatar">
        <Image
          class="wordmark-avatar-image wordmark-avatar-color"
          src={portrait}
          alt=""
          aria-hidden="true"
          width={160}
          quality={82}
          loading="eager"
        />
        <Image
          class="wordmark-avatar-image wordmark-avatar-mono"
          src={portrait}
          alt=""
          aria-hidden="true"
          width={160}
          quality={82}
          loading="eager"
        />
      </span>
      <span class="wordmark-name">Fabian Deragisch</span>
    </a>

    <div class="header-status-control">
      <div
        class="header-note header-note-static header-note-desktop"
        aria-label="Status: Wahrscheinlich am Tee zubereiten"
      >
        <span class="header-note-mark" aria-hidden="true">
          <span class="header-teapot">
            <i class="header-teapot-lid"></i>
            <i class="header-teapot-body"></i>
            <i class="header-teapot-spout"></i>
            <i class="header-teapot-handle"></i>
          </span>
          <span class="header-tea-steam"><i></i><i></i></span>
        </span>
        <span class="header-note-copy">
          <strong>Wahrscheinlich am Tee zubereiten</strong>
        </span>
      </div>

      <button
        class="header-note-mobile"
        type="button"
        data-status-trigger
        aria-expanded="false"
        aria-label="Status: Gerade wahrscheinlich am Tee zubereiten"
      >
        <span class="status-mobile-compact" aria-hidden="true">
          <span class="header-note-mark">
            <span class="header-teapot">
              <i class="header-teapot-lid"></i>
              <i class="header-teapot-body"></i>
              <i class="header-teapot-spout"></i>
              <i class="header-teapot-handle"></i>
            </span>
            <span class="header-tea-steam"><i></i><i></i></span>
          </span>
        </span>
        <span class="status-mobile-expanded" aria-hidden="true">
          <span class="status-panel-portrait">
            <Image
              src={portrait}
              alt=""
              width={320}
              quality={86}
              loading="eager"
            />
          </span>
          <span class="status-panel-copy">
            <span class="status-panel-label">Gerade wahrscheinlich</span>
            <strong>am Tee zubereiten.</strong>
            <span class="status-panel-signature">Fabian Deragisch · Wien</span>
          </span>
        </span>
      </button>
    </div>
  </div>

  <nav aria-label="Hauptnavigation">
    <a href="#beruf">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Berufserfahrung</span><span class="nav-short">Beruf</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Berufserfahrung</span><span class="nav-short">Beruf</span></span>
      </span>
    </a>
    <a href="#ausbildung">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Studium + Bachelorarbeit</span><span class="nav-short">Studium</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Studium + Bachelorarbeit</span><span class="nav-short">Studium</span></span>
      </span>
    </a>
    <a href="#persoenlich">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Persönlich</span><span class="nav-short">Privat</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Persönlich</span><span class="nav-short">Privat</span></span>
      </span>
    </a>
    <a href="#kontakt">
      <span class="nav-label">
        <span class="nav-label-primary">Kontakt</span>
        <span class="nav-label-clone" aria-hidden="true">Kontakt</span>
      </span>
    </a>
  </nav>
</header>

<a class="mobile-contact-shortcut" href="#kontakt" data-mobile-contact aria-label="Direkt zu den Kontaktmöglichkeiten">
  <i class="ph ph-envelope-simple" aria-hidden="true"></i>
  <span>Kontakt</span>
</a>

<script>
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  const statusTrigger = siteHeader?.querySelector<HTMLButtonElement>("[data-status-trigger]");
  const mobileContact = document.querySelector<HTMLAnchorElement>("[data-mobile-contact]");
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-site-header] nav a[href^='#']"));
  const observedSections = sectionLinks
    .map((link) => {
      const id = link.hash.slice(1);
      const section = document.getElementById(id);
      return section ? { link, section } : null;
    })
    .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(entry));

  const setCurrentSection = (activeLink: HTMLAnchorElement) => {
    sectionLinks.forEach((link) => {
      if (link === activeLink) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
    siteHeader?.setAttribute("data-section-mode", activeLink.hash === "#persoenlich" || activeLink.hash === "#kontakt" ? "personal" : "professional");
  };

  if ("IntersectionObserver" in window) {
    const navigationObserver = new IntersectionObserver(
      (entries) => {
        const active = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!active) return;
        const match = observedSections.find(({ section }) => section === active.target);
        if (match) setCurrentSection(match.link);
      },
      { rootMargin: "-18% 0px -62%", threshold: [0, 0.12, 0.4] },
    );
    observedSections.forEach(({ section }) => navigationObserver.observe(section));
  }

  sectionLinks.forEach((link) => link.addEventListener("click", () => setCurrentSection(link)));

  const setStatusOpen = (open: boolean) => {
    if (!statusTrigger) return;
    statusTrigger.setAttribute("aria-expanded", String(open));
    statusTrigger.classList.toggle("is-open", open);
    statusTrigger.closest(".header-identity")?.classList.toggle("is-status-open", open);
    siteHeader?.classList.toggle("is-status-open", open);
  };

  statusTrigger?.addEventListener("click", (event) => {
    event.stopPropagation();
    setStatusOpen(statusTrigger.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("click", () => setStatusOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || statusTrigger?.getAttribute("aria-expanded") !== "true") return;
    setStatusOpen(false);
    statusTrigger.focus();
  });

  const contactSection = document.getElementById("kontakt");
  let contactScrollFrame = 0;
  const syncMobileContact = () => {
    contactScrollFrame = 0;
    mobileContact?.classList.toggle("is-compact", window.scrollY > 96);
    setStatusOpen(false);
  };

  window.addEventListener("scroll", () => {
    if (contactScrollFrame) return;
    contactScrollFrame = window.requestAnimationFrame(syncMobileContact);
  }, { passive: true });
  syncMobileContact();

  if (mobileContact && contactSection && "IntersectionObserver" in window) {
    const contactObserver = new IntersectionObserver(
      ([entry]) => mobileContact.classList.toggle("is-hidden", Boolean(entry?.isIntersecting)),
      { threshold: 0.08 },
    );
    contactObserver.observe(contactSection);
  }
</script>
