---
import { Image } from "astro:assets";
import portrait from "../assets/portrait/fabian-deragisch.jpg";
---

<header class="site-header" data-site-header>
  <div class="header-identity">
    <a class="wordmark" href="#oben" aria-label="Zurück zum Anfang">
      <span class="wordmark-avatar">
        <Image
          class="wordmark-avatar-image wordmark-avatar-color"
          src={portrait}
          alt=""
          aria-hidden="true"
          width={160}
          quality={82}
          loading="eager"
        />
        <Image
          class="wordmark-avatar-image wordmark-avatar-mono"
          src={portrait}
          alt=""
          aria-hidden="true"
          width={160}
          quality={82}
          loading="eager"
        />
      </span>
      <span class="wordmark-name">Fabian Deragisch</span>
    </a>

    <div class="header-status-control">
      <button
        class="header-note header-note-static header-note-desktop"
        type="button"
        data-status-trigger-desktop
        aria-expanded="false"
        aria-label="Status öffnen: Gerade wahrscheinlich beim Teeaufgießen"
      >
        <span class="header-note-compact">
          <span class="header-note-mark status-activity-visual" data-status-visual data-status-kind="tea" aria-hidden="true">
            <span class="status-activity-tea">
              <span class="header-teapot">
                <i class="header-teapot-lid"></i>
                <i class="header-teapot-body"></i>
                <i class="header-teapot-spout"></i>
                <i class="header-teapot-handle"></i>
              </span>
              <span class="header-tea-steam"><i></i><i></i></span>
            </span>
            <i class="ph ph-leaf status-activity-icon" data-status-icon></i>
          </span>
          <span class="header-note-copy">
            <strong data-status-short>Tee wird aufgegossen</strong>
          </span>
        </span>
        <span class="status-desktop-expanded" aria-hidden="true" data-status-expanded-desktop>
          <span class="status-panel-label">Gerade wahrscheinlich</span>
          <strong data-status-detail>beim Teeaufgießen.</strong>
          <span class="status-desktop-close" aria-hidden="true">
            <i class="ph ph-x"></i>
          </span>
        </span>
      </button>

      <button
        class="header-note-mobile"
        type="button"
        data-status-trigger-mobile
        aria-expanded="false"
        aria-label="Status öffnen: Gerade wahrscheinlich beim Teeaufgießen"
      >
        <span class="status-mobile-portrait" aria-hidden="true">
          <Image
            src={portrait}
            alt=""
            width={320}
            quality={86}
            loading="eager"
          />
        </span>
        <span class="status-mobile-compact" aria-hidden="true">
          <span class="header-note-mark status-activity-visual" data-status-visual data-status-kind="tea">
            <span class="status-activity-tea">
              <span class="header-teapot">
                <i class="header-teapot-lid"></i>
                <i class="header-teapot-body"></i>
                <i class="header-teapot-spout"></i>
                <i class="header-teapot-handle"></i>
              </span>
              <span class="header-tea-steam"><i></i><i></i></span>
            </span>
            <i class="ph ph-leaf status-activity-icon" data-status-icon></i>
          </span>
        </span>
        <span class="status-mobile-expanded" aria-hidden="true">
          <span class="status-panel-copy">
            <span class="status-panel-label">Gerade wahrscheinlich</span>
            <strong data-status-detail>beim Teeaufgießen.</strong>
          </span>
        </span>
      </button>
    </div>
  </div>

  <nav aria-label="Hauptnavigation">
    <a href="#beruf">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Berufserfahrung</span><span class="nav-short">Beruf</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Berufserfahrung</span><span class="nav-short">Beruf</span></span>
      </span>
    </a>
    <a href="#ausbildung">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Studium + Bachelorarbeit</span><span class="nav-short">Studium</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Studium + Bachelorarbeit</span><span class="nav-short">Studium</span></span>
      </span>
    </a>
    <a href="#persoenlich">
      <span class="nav-label">
        <span class="nav-label-primary"><span class="nav-long">Persönlich</span><span class="nav-short">Privat</span></span>
        <span class="nav-label-clone" aria-hidden="true"><span class="nav-long">Persönlich</span><span class="nav-short">Privat</span></span>
      </span>
    </a>
    <a href="#kontakt">
      <span class="nav-label">
        <span class="nav-label-primary">Kontakt</span>
        <span class="nav-label-clone" aria-hidden="true">Kontakt</span>
      </span>
    </a>
  </nav>
</header>

<a class="mobile-contact-shortcut" href="#kontakt" data-mobile-contact aria-label="Direkt zu den Kontaktmöglichkeiten">
  <i class="ph ph-envelope-simple" aria-hidden="true"></i>
  <span>Kontakt</span>
</a>

<script>
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  const desktopStatusTrigger = siteHeader?.querySelector<HTMLButtonElement>("[data-status-trigger-desktop]");
  const desktopStatusExpanded = siteHeader?.querySelector<HTMLElement>("[data-status-expanded-desktop]");
  const mobileStatusTrigger = siteHeader?.querySelector<HTMLButtonElement>("[data-status-trigger-mobile]");
  const mobileContact = document.querySelector<HTMLAnchorElement>("[data-mobile-contact]");
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-site-header] nav a[href^='#']"));
  const observedSections = sectionLinks
    .map((link) => {
      const id = link.hash.slice(1);
      const section = document.getElementById(id);
      return section ? { link, section } : null;
    })
    .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(entry));

  const setCurrentSection = (activeLink: HTMLAnchorElement) => {
    sectionLinks.forEach((link) => {
      if (link === activeLink) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
    siteHeader?.setAttribute("data-section-mode", activeLink.hash === "#persoenlich" || activeLink.hash === "#kontakt" ? "personal" : "professional");
  };

  if ("IntersectionObserver" in window) {
    const navigationObserver = new IntersectionObserver(
      (entries) => {
        const active = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!active) return;
        const match = observedSections.find(({ section }) => section === active.target);
        if (match) setCurrentSection(match.link);
      },
      { rootMargin: "-18% 0px -62%", threshold: [0, 0.12, 0.4] },
    );
    observedSections.forEach(({ section }) => navigationObserver.observe(section));
  }

  sectionLinks.forEach((link) => link.addEventListener("click", () => setCurrentSection(link)));

  type StatusKind = "tea" | "training" | "music" | "camera" | "night";
  type StatusProfile = {
    kind: StatusKind;
    short: string;
    detail: string;
    icon: string;
  };

  const statusProfiles = {
    teaMorning: {
      kind: "tea",
      short: "Beim ersten Sencha-Aufguss",
      detail: "beim ersten Sencha-Aufguss.",
      icon: "ph-leaf",
    },
    teaBreak: {
      kind: "tea",
      short: "Beim nächsten Sencha-Aufguss",
      detail: "beim nächsten Sencha-Aufguss.",
      icon: "ph-leaf",
    },
    teaDay: {
      kind: "tea",
      short: "Tee wird aufgegossen",
      detail: "beim Teeaufgießen.",
      icon: "ph-leaf",
    },
    training: {
      kind: "training",
      short: "Wahrscheinlich im Fitnessstudio",
      detail: "im Fitnessstudio.",
      icon: "ph-barbell",
    },
    music: {
      kind: "music",
      short: "Mit Musik im Ohr",
      detail: "mit Musik im Ohr.",
      icon: "ph-headphones",
    },
    camera: {
      kind: "camera",
      short: "Mit der Kamera unterwegs",
      detail: "mit der Kamera unterwegs.",
      icon: "ph-camera",
    },
    night: {
      kind: "night",
      short: "Gerade eher offline",
      detail: "nicht mehr am Bildschirm.",
      icon: "ph-moon-stars",
    },
  } as const satisfies Record<string, StatusProfile>;

  const selectStatus = (date: Date): StatusProfile => {
    const minutes = date.getHours() * 60 + date.getMinutes();
    const day = date.getDay();
    const isWeekday = day >= 1 && day <= 5;

    if (isWeekday) {
      if (minutes < 7 * 60) return statusProfiles.night;
      if (minutes < 8 * 60) return statusProfiles.teaMorning;
      if (minutes < 12 * 60) return statusProfiles.teaDay;
      if (minutes < 13 * 60) return statusProfiles.teaBreak;
      if (minutes < 17 * 60) return statusProfiles.teaDay;
      if (minutes < 19 * 60) return statusProfiles.training;
      if (minutes < 23 * 60 + 30) return statusProfiles.music;
      return statusProfiles.night;
    }

    if (minutes < 8 * 60 + 30) return statusProfiles.night;
    if (minutes < 11 * 60 + 30) return statusProfiles.teaMorning;
    if (minutes < 17 * 60) return statusProfiles.camera;
    if (minutes < 19 * 60) return statusProfiles.training;
    if (minutes < 23 * 60 + 30) return statusProfiles.music;
    return statusProfiles.night;
  };

  let activeStatusKey = "";
  const syncStatus = (animate = false) => {
    const profile = selectStatus(new Date());
    const nextKey = `${profile.kind}:${profile.short}`;
    if (nextKey === activeStatusKey) return;
    activeStatusKey = nextKey;

    const animatedNodes = Array.from(siteHeader?.querySelectorAll<HTMLElement>(".header-note") ?? []);
    if (animate) animatedNodes.forEach((node) => node.classList.add("is-status-changing"));

    const applyProfile = () => {
      siteHeader?.querySelectorAll<HTMLElement>("[data-status-short]").forEach((node) => {
        node.textContent = profile.short;
      });
      siteHeader?.querySelectorAll<HTMLElement>("[data-status-detail]").forEach((node) => {
        node.textContent = profile.detail;
      });
      siteHeader?.querySelectorAll<HTMLElement>("[data-status-visual]").forEach((node) => {
        node.dataset.statusKind = profile.kind;
      });
      siteHeader?.querySelectorAll<HTMLElement>("[data-status-icon]").forEach((node) => {
        node.className = `ph ${profile.icon} status-activity-icon`;
      });
      [desktopStatusTrigger, mobileStatusTrigger].forEach((trigger) => {
        const action = trigger?.getAttribute("aria-expanded") === "true" ? "schließen" : "öffnen";
        trigger?.setAttribute("aria-label", `Status ${action}: Gerade wahrscheinlich ${profile.detail}`);
      });
      animatedNodes.forEach((node) => node.classList.remove("is-status-changing"));
    };

    if (animate && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.setTimeout(applyProfile, 100);
    } else {
      applyProfile();
    }
  };

  syncStatus();
  window.setInterval(() => syncStatus(true), 60_000);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) syncStatus(true);
  });

  const setMobileStatusOpen = (open: boolean) => {
    if (!mobileStatusTrigger) return;
    mobileStatusTrigger.setAttribute("aria-expanded", String(open));
    mobileStatusTrigger.setAttribute(
      "aria-label",
      mobileStatusTrigger.getAttribute("aria-label")?.replace(open ? "öffnen" : "schließen", open ? "schließen" : "öffnen") ?? "",
    );
    mobileStatusTrigger.classList.toggle("is-open", open);
    mobileStatusTrigger.closest(".header-identity")?.classList.toggle("is-status-open", open);
    siteHeader?.classList.toggle("is-status-open", open);
  };

  const setDesktopStatusOpen = (open: boolean) => {
    if (!desktopStatusTrigger) return;
    desktopStatusTrigger.setAttribute("aria-expanded", String(open));
    desktopStatusTrigger.setAttribute(
      "aria-label",
      desktopStatusTrigger.getAttribute("aria-label")?.replace(open ? "öffnen" : "schließen", open ? "schließen" : "öffnen") ?? "",
    );
    desktopStatusTrigger.classList.toggle("is-open", open);
    desktopStatusExpanded?.setAttribute("aria-hidden", String(!open));
  };

  const closeStatuses = () => {
    setMobileStatusOpen(false);
    setDesktopStatusOpen(false);
  };

  mobileStatusTrigger?.addEventListener("click", (event) => {
    event.stopPropagation();
    setDesktopStatusOpen(false);
    setMobileStatusOpen(mobileStatusTrigger.getAttribute("aria-expanded") !== "true");
  });

  desktopStatusTrigger?.addEventListener("click", (event) => {
    event.stopPropagation();
    setMobileStatusOpen(false);
    setDesktopStatusOpen(desktopStatusTrigger.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("click", closeStatuses);
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (mobileStatusTrigger?.getAttribute("aria-expanded") === "true") {
      setMobileStatusOpen(false);
      mobileStatusTrigger.focus();
    } else if (desktopStatusTrigger?.getAttribute("aria-expanded") === "true") {
      setDesktopStatusOpen(false);
      desktopStatusTrigger.focus();
    }
  });

  const contactSection = document.getElementById("kontakt");
  let contactScrollFrame = 0;
  const syncMobileContact = () => {
    contactScrollFrame = 0;
    mobileContact?.classList.toggle("is-compact", window.scrollY > 96);
    closeStatuses();
  };

  window.addEventListener("scroll", () => {
    if (contactScrollFrame) return;
    contactScrollFrame = window.requestAnimationFrame(syncMobileContact);
  }, { passive: true });
  syncMobileContact();

  if (mobileContact && contactSection && "IntersectionObserver" in window) {
    const contactObserver = new IntersectionObserver(
      ([entry]) => mobileContact.classList.toggle("is-hidden", Boolean(entry?.isIntersecting)),
      { threshold: 0.08 },
    );
    contactObserver.observe(contactSection);
  }
</script>
