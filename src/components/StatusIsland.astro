---
import { Image } from "astro:assets";
import portrait from "../assets/portrait/fabian-deragisch.jpg";
---

<div class="status-anchor">
  <button
    class="status-island"
    type="button"
    data-status-trigger
    aria-expanded="false"
    aria-controls="status-detail"
    aria-label="Status öffnen: Gerade wahrscheinlich beim Teeaufgießen."
  >
    <span class="status-portrait" aria-hidden="true">
      <Image src={portrait} alt="" width={160} quality={86} loading="eager" />
    </span>
    <span class="status-name" translate="no" data-no-translate>Fabian Deragisch</span>
    <span class="status-glance" aria-hidden="true"><i class="ph ph-leaf" data-status-icon></i></span>
    <span class="status-chevron" aria-hidden="true"><i class="ph ph-caret-down"></i></span>
    <span class="status-detail" id="status-detail" aria-hidden="true">
      <span class="status-detail-icon" aria-hidden="true"><i class="ph ph-leaf" data-status-icon></i></span>
      <span class="status-copy">
        <span class="status-caption">Gerade wahrscheinlich</span>
        <strong data-status-detail>beim Teeaufgießen.</strong>
      </span>
    </span>
  </button>
</div>

<style>
  /* Reserve the closed size so that opening never pushes the navigation. */
  .status-anchor {
    position: relative;
    z-index: 2;
    flex: 0 0 18rem;
    width: 18rem;
    height: 3.5rem;
    align-self: flex-start;
  }
  .status-island {
    --island-ease: cubic-bezier(0.22, 0.8, 0.24, 1.035);
    position: absolute;
    inset: 0 auto auto 0;
    display: block;
    overflow: hidden;
    width: 18rem;
    height: 3.5rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--line-strong) 46%, transparent);
    border-radius: 1.05rem;
    background: color-mix(in srgb, var(--surface) 97%, var(--accent-soft));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.7), 0 3px 8px rgb(42 49 35 / 0.035), 0 12px 30px rgb(42 49 35 / 0.075);
    color: var(--ink);
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
    isolation: isolate;
    transition: width 500ms var(--island-ease), height 500ms var(--island-ease), border-radius 500ms var(--island-ease), background-color 220ms ease, border-color 220ms ease, box-shadow 320ms ease;
  }
  .status-island[aria-expanded="true"] {
    width: min(21rem, calc(100vw - 1.3rem));
    height: 8.25rem;
    border-radius: 1.3rem;
    border-color: color-mix(in srgb, var(--accent) 42%, var(--line));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.75), 0 4px 12px rgb(42 49 35 / 0.04), 0 18px 42px rgb(42 49 35 / 0.14);
  }
  .status-portrait {
    position: absolute;
    top: 0.4375rem;
    left: 0.4375rem;
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    border-radius: 0.7rem;
    transform-origin: top left;
    transition: transform 500ms var(--island-ease), border-radius 500ms var(--island-ease);
  }
  .status-portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .status-island[aria-expanded="true"] .status-portrait { transform: scale(1.1); border-radius: 0.8rem; }
  /* Copy has its final geometry from the start; only the surface and portrait grow. */
  .status-name {
    position: absolute;
    top: 1.04rem;
    left: 3.85rem;
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.25rem;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .status-glance, .status-detail-icon {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent-soft) 72%, var(--surface));
    color: var(--accent-strong);
  }
  .status-glance {
    position: absolute;
    top: 0.6875rem;
    left: 13.75rem;
    width: 2rem;
    height: 2rem;
    font-size: 1.15rem;
    transition: opacity 140ms ease;
  }
  .status-island[aria-expanded="true"] .status-glance { opacity: 0; }
  .status-chevron {
    position: absolute;
    top: 1.0625rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    font-size: 0.8rem;
    color: var(--muted);
    transition: transform 440ms var(--island-ease);
  }
  .status-island[aria-expanded="true"] .status-chevron { transform: rotate(180deg); }
  .status-detail {
    position: absolute;
    top: 3.8rem;
    left: 0.875rem;
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr);
    align-items: center;
    gap: 0.675rem;
    width: min(19.125rem, calc(100vw - 3.175rem));
    min-height: 3.45rem;
    padding-top: 0.65rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 62%, transparent);
    opacity: 0;
    transition: opacity 130ms ease;
  }
  .status-island[aria-expanded="true"] .status-detail { opacity: 1; transition: opacity 260ms 130ms ease; }
  .status-detail-icon { width: 2.3rem; height: 2.3rem; font-size: 1.2rem; }
  .status-copy { display: grid; gap: 0.22rem; align-content: center; }
  .status-caption { color: var(--muted); font-size: 0.68rem; line-height: 1.3; font-weight: 500; }
  .status-copy strong { color: var(--ink); font-size: 0.875rem; line-height: 1.35; font-weight: 600; letter-spacing: -0.015em; }
  .status-island:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  .status-island:active { background: color-mix(in srgb, var(--surface) 84%, var(--accent-soft)); }
  @media (hover: hover) and (pointer: fine) {
    .status-island:hover {
      border-color: color-mix(in srgb, var(--accent) 65%, var(--line));
      background: color-mix(in srgb, var(--surface) 91%, var(--accent-soft));
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), 0 4px 10px rgb(42 49 35 / 0.045), 0 14px 32px rgb(42 49 35 / 0.11);
    }
  }
  @media (max-width: 48rem) {
    .status-anchor { flex-basis: 5.35rem; width: 5.35rem; height: 2.95rem; }
    .status-island { width: 5.35rem; height: 2.95rem; border-radius: 1rem; }
    .status-portrait { top: 0.3rem; left: 0.3rem; width: 2.25rem; height: 2.25rem; border-radius: 0.7rem; }
    .status-island[aria-expanded="true"] .status-portrait { transform: translate(2px, 2px) scale(1.22); }
    .status-glance { top: 0.4rem; left: 2.825rem; width: 2rem; height: 2rem; }
    .status-name, .status-chevron { opacity: 0; pointer-events: none; transition: opacity 100ms ease; }
    .status-chevron { right: auto; left: min(18.8rem, calc(100vw - 3.5rem)); }
    .status-island[aria-expanded="true"] .status-name,
    .status-island[aria-expanded="true"] .status-chevron { opacity: 1; transition: opacity 220ms 140ms ease; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-island, .status-island * { transition: none !important; }
  }
</style>

<script>
  const trigger = document.querySelector<HTMLButtonElement>("[data-status-trigger]");
  const detail = trigger?.querySelector<HTMLElement>(".status-detail");
  const profiles = {
    morning: { detail: "beim ersten Sencha-Aufguss.", icon: "ph-leaf" },
    break: { detail: "beim nächsten Sencha-Aufguss.", icon: "ph-leaf" },
    tea: { detail: "beim Teeaufgießen.", icon: "ph-leaf" },
    training: { detail: "im Fitnessstudio.", icon: "ph-barbell" },
    music: { detail: "mit Musik im Ohr.", icon: "ph-headphones" },
    camera: { detail: "mit der Kamera unterwegs.", icon: "ph-camera" },
    night: { detail: "nicht mehr am Bildschirm.", icon: "ph-moon-stars" },
  };
  const selectProfile = (date: Date) => {
    const minutes = date.getHours() * 60 + date.getMinutes();
    const weekday = date.getDay() >= 1 && date.getDay() <= 5;
    if (weekday) {
      if (minutes < 420) return profiles.night;
      if (minutes < 480) return profiles.morning;
      if (minutes < 720) return profiles.tea;
      if (minutes < 780) return profiles.break;
      if (minutes < 1020) return profiles.tea;
    } else {
      if (minutes < 510) return profiles.night;
      if (minutes < 690) return profiles.morning;
      if (minutes < 1020) return profiles.camera;
    }
    if (minutes < 1140) return profiles.training;
    if (minutes < 1410) return profiles.music;
    return profiles.night;
  };
  let activeDetail = "";
  const syncProfile = () => {
    const profile = selectProfile(new Date());
    if (activeDetail === profile.detail) return;
    activeDetail = profile.detail;
    trigger?.querySelectorAll<HTMLElement>("[data-status-detail]").forEach(node => { node.textContent = profile.detail; });
    trigger?.querySelectorAll<HTMLElement>("[data-status-icon]").forEach(node => { node.className = `ph ${profile.icon}`; });
    // The locale observer also translates accessible labels when the status changes.
    trigger?.setAttribute("aria-label", `Status ${trigger.getAttribute("aria-expanded") === "true" ? "schließen" : "öffnen"}: Gerade wahrscheinlich ${profile.detail}`);
  };
  const setOpen = (open: boolean) => {
    if (!trigger) return;
    trigger.setAttribute("aria-expanded", String(open));
    detail?.setAttribute("aria-hidden", String(!open));
    const label = trigger.getAttribute("aria-label") ?? "";
    const description = label.slice(label.indexOf(":"));
    const action = document.documentElement.lang === "en" ? `${open ? "Close" : "Open"} status` : `Status ${open ? "schließen" : "öffnen"}`;
    trigger.setAttribute("aria-label", `${action}${description}`);
  };
  trigger?.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("click", event => {
    if (event.target instanceof Node && !trigger?.contains(event.target)) setOpen(false);
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && trigger?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      trigger.focus({ preventScroll: true });
    }
  });
  window.addEventListener("scroll", () => setOpen(false), { passive: true });
  window.matchMedia("(max-width: 48rem)").addEventListener("change", () => setOpen(false));
  document.addEventListener("visibilitychange", () => { if (!document.hidden) syncProfile(); });
  syncProfile();
  window.setInterval(syncProfile, 60_000);
</script>
