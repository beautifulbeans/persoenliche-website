---
import "@fontsource-variable/cormorant-garamond/index.css";
import "@fontsource-variable/manrope/index.css";
import "@phosphor-icons/web/regular/style.css";
import "../styles/global.css";
import "../styles/refinement.css";
import "../styles/latest.css";
import "../styles/photographic-opening.css";
import type { JsonLd } from "../data/structuredData";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  themeColor?: string;
  bodyClass?: string;
  structuredData?: JsonLd | JsonLd[];
}

const {
  title = "Fabian Deragisch | Marketing, E-Commerce & Teeliebhaber",
  description =
    "Portfolio von Fabian Deragisch: Marketing, E-Commerce und persönliche Einblicke – immer mit einer Tasse Tee in Reichweite.",
  robots = "index, follow",
  themeColor = "#f2f3ed",
  bodyClass,
  structuredData,
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content="Fabian Deragisch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {serializedStructuredData && (
      <script is:inline type="application/ld+json" set:html={serializedStructuredData}></script>
    )}
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <slot />
  </body>
</html>
